# Settings for logos-http-channel: copy to .env.
#
# `docker compose up` reads .env too, and a value set here wins over the
# compose file's own, which reach core's dev stack from inside its network.
# So only the broker password is set here. To run the channel on the host
# (go run ./cmd/http-channel --config .env), uncomment what you change; the
# values shown are the defaults, which reach logos-core's dev stack from
# the host.

# Core's broker password (logos-core's RABBITMQ_DEFAULT_PASS): required.
RABBITMQ_PASSWORD=

# CHANNEL_ID is also this instance's registration id; it must be unique per instance.
#CHANNEL_ID=http-main
# On the host, pick another port: logos-core's nginx has 8080.
#LISTEN_ADDR=:8080
#LOGOS_SYNC_BASE_URL=http://localhost:8002
# How long a client request waits for core's sync reply (Go duration)
#CORE_SYNC_TIMEOUT=30s
# Internal health server; keep it unpublished (Docker network only)
#HEALTH_LISTEN_ADDR=:8081
# Maximum client request body size in bytes
#MAX_BODY_BYTES=1048576
# stderr log format: json (default, for aggregators) or text (logfmt)
#LOG_FORMAT=json
# Proxies (IPs/CIDRs, comma-separated) whose X-Forwarded-For / X-Real-IP is
# believed for the logged client_ip. Empty: log the peer address.
#TRUSTED_PROXIES=

# RabbitMQ (core's control plane) for module registration
#RABBITMQ_HOST=localhost
#RABBITMQ_PORT=5672
#RABBITMQ_USER=logos
#RABBITMQ_VHOST=/
